{
  "name": "llmswapper",
  "private": true,
  "version": "0.1.1",
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "index.client.ts",
    "index.client.tsx",
    "index.server.ts",
    "index.server.tsx",
    "client/",
    "server/",
    "shared/",
    "README.md",
    "types/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"test/**/*.test.ts\"",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:live": "node scripts/live-bridge-check.mjs"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.11.2",
    "@tanstack/react-query": "^5.90.11",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3",
    "@types/node": "^24.0.0"
  },
  "description": "Paseo plugin: one compact panel for the LLMswapper accounts of every paired device",
  "engines": {
    "node": ">=22.18"
  }
}
